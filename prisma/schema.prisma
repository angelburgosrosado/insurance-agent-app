generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  superadmin
  admin
  user
}

enum LeadStatus {
  new
  reviewing
  assigned
  contacted
  qualified
  closed
}

enum FollowUpTaskStatus {
  pending
  completed
  cancelled
}

enum ContentStatus {
  draft
  published
  archived
}

enum CampaignStatus {
  draft
  active
  paused
  completed
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  name          String?
  role          StaffRole      @default(user)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignedLeads Lead[]         @relation("LeadAssignee")
  authoredNotes LeadNote[]     @relation("NoteAuthor")
  assignedTasks FollowUpTask[] @relation("TaskAssignee")
  auditEvents   AuditEvent[]   @relation("AuditActor")

  @@index([role])
}

model Lead {
  id             String           @id @default(uuid()) @db.Uuid
  firstName      String
  lastName       String
  email          String
  phone          String
  service        String
  contactTime    String?
  message        String?
  status         LeadStatus       @default(new)
  consent        Boolean
  consentText    String
  consentVersion String
  consentAt      DateTime
  assignedToId   String?          @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  assignedTo     User?            @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  attribution    LeadAttribution?
  notes          LeadNote[]
  followUpTasks  FollowUpTask[]

  @@index([status, createdAt])
  @@index([email])
  @@index([assignedToId])
}

model LeadAttribution {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @unique @db.Uuid
  source    String?
  medium    String?
  campaign  String?
  content   String?
  term      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([source, medium, campaign])
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([authorId])
}

model FollowUpTask {
  id         String             @id @default(uuid()) @db.Uuid
  leadId     String             @db.Uuid
  assigneeId String?            @db.Uuid
  title      String
  dueAt      DateTime?
  status     FollowUpTaskStatus @default(pending)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  lead       Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee   User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([leadId])
  @@index([assigneeId])
}

model ContentEntry {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  body        String
  status      ContentStatus @default(draft)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

model Campaign {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  key       String         @unique
  status    CampaignStatus @default(draft)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, startsAt])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
