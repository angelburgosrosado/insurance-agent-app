{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/api/leads/quote-routing",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "X-MyIAD-Pipeline",
          "value": "crm.myiad.com"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "crm\\.myiad\\.com"
        }
      ],
      "destination": "/crm"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "crm\\.myiad\\.net"
        }
      ],
      "destination": "/crm"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>.*)myiad\\.com"
        }
      ],
      "destination": "/myiad"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<subdomain>.*)myiad\\.net"
        }
      ],
      "destination": "/myiad"
    }
  ]
}
