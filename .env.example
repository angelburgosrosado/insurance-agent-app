# ==============================================================================
# MyIAD & InsuranceAI CRM - Environment Configuration Template
# ==============================================================================
# Use this template to configure environment variables in Vercel or locally.
#
# Target Environments:
#   1. myiad.com       (Next.js Main Web Platform & Lead Intake Engine)
#   2. crm.myiad.com   (Internal Functional CRM Copy for Angel Burgos / AB Global)
#   3. crm.myiad.net   (Licensed Agency-Facing InsuranceAI CRM Platform)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon PostgreSQL) - REQUIRED FOR ALL
# ------------------------------------------------------------------------------
# All apps share or sync to the Neon serverless PostgreSQL cluster.
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-ENDPOINT.us-east-2.aws.neon.tech/neondb?sslmode=require"

# (Optional Vite alias if running the standalone InsuranceAI-CRM frontend)
VITE_NEON_DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-ENDPOINT.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SITE & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# For myiad.com:
NEXT_PUBLIC_SITE_URL="https://myiad.com"

# For crm.myiad.com:
# NEXT_PUBLIC_SITE_URL="https://crm.myiad.com"
# VITE_APP_URL="https://crm.myiad.com"

# For crm.myiad.net:
# NEXT_PUBLIC_SITE_URL="https://crm.myiad.net"
# VITE_APP_URL="https://crm.myiad.net"

# ------------------------------------------------------------------------------
# 3. CRM WEBHOOK & PIPELINE INTEGRATION
# ------------------------------------------------------------------------------
# Configured in myiad.com to dispatch leads into the CRM pipeline.
#
# Option A: Route to your internal crm.myiad.com:
CRM_WEBHOOK_URL="https://crm.myiad.com/api/webhooks/leads"
CRM_MYIAD_WEBHOOK_URL="https://crm.myiad.com/api/webhooks/leads"

# Option B: Route to agency crm.myiad.net:
# CRM_WEBHOOK_URL="https://crm.myiad.net/api/webhooks/leads"
# CRM_MYIAD_WEBHOOK_URL="https://crm.myiad.net/api/webhooks/leads"

# Webhook Authentication & Security (Must match between myiad.com and CRM)
CRM_WEBHOOK_SECRET="myiad_webhook_secret_production_2026_abglobal"
CRM_MYIAD_WEBHOOK_SECRET="myiad_webhook_secret_production_2026_abglobal"
CRM_WEBHOOK_API_KEY="myiad_api_key_production_2026"
CRM_MYIAD_API_KEY="myiad_api_key_production_2026"

# Payload Encryption (AES-256-GCM 32-byte key - optional, defaults to secure transmission)
# Generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CRM_ENCRYPTION_KEY=""
CRM_MYIAD_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 4. ADVISOR NOTIFICATIONS: TWILIO (SMS & Voice Inbound Relay)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1386XXXXXXX"
TWILIO_MESSAGING_SERVICE_SID=""

# Direct Advisor Alert Phone (Receives instant SMS upon lead submission)
ADVISOR_NOTIFICATION_PHONE="+13863331482"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL DISPATCH (SendGrid or Resend)
# ------------------------------------------------------------------------------
# Used for consumer auto-replies, executive reports, and blueprint delivery
SENDGRID_API_KEY="SG.your_sendgrid_api_key"
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="angel@abglco.com"
EMAIL_FROM_NAME="Angel Burgos • AB Global Consulting"

# ------------------------------------------------------------------------------
# 6. AI AGENTS & SPEECH SYNTHESIS
# ------------------------------------------------------------------------------
# Google Gemini (Primary AI Copilot & Lead Synthesis)
GEMINI_API_KEY="your_google_gemini_api_key"

# OpenAI (Fallback AI Copilot & Embeddings)
OPENAI_API_KEY="your_openai_api_key"

# Deepgram (Voice Agent STT / TTS & Twilio ConversationRelay)
DEEPGRAM_API_KEY="your_deepgram_api_key"

# ------------------------------------------------------------------------------
# 7. INTERNAL ADMIN & SCHEDULING
# ------------------------------------------------------------------------------
# PIN for accessing internal /admin routes
STAFF_ADMIN_PIN="2026"

# Scheduling bridge for quote confirmations
NEXT_PUBLIC_CALENDLY_URL="https://cal.com/angelburgos/15min"

# Node environment flag
NODE_ENV="production"
